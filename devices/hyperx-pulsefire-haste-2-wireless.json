{
  "profileVersion": 1,
  "id": "hyperx-pulsefire-haste-2-wireless",
  "protocol": "ngenuity-universal",

  "_documentation": {
    "about": "HyperX Pulsefire Haste 2 Wireless (HP/HyperX 2.4GHz dongle, VID 0x03F0 / PID 0x0F98・0x0D97) 用プロファイル。NGENUITY 3.x の「universal」HIDプロトコルを使用します。",
    "protocolSource": "https://github.com/PMarinov1994/ngenuity-linux-cli — NGENUITY 3.1.0 の通信ハブを解析したuniversalプロトコル資料（DPI/LED/LOD/バッテリーの読み書き）。HaloBattery の docs/protocols.md も参照",
    "howItWorks": "ドングルのベンダーコレクション (interface 2 / usagePage 0xFF00) に64バイトのレポートを送ります。レポートIDがコマンドバイト、byte1がサブコマンドです。応答はコマンド+1のレポートIDで返り、ドングルは全パケットに ff 01 … のACKを返します。DPIテーブル (32 01/02) にDPI・有効ステージ・現在ステージ・ステージ色・ポーリングレートがまとまっており、読み戻しにも対応します。",
    "verifiedOn": "2026-11-19: HyperX Pulsefire Haste 2 Wireless (03f0:0f98) — 10 01 / 52 01 / 50 02 の読み取り、32 02 / 36 02 / 40 02 / 42 03 の読み戻し、32 01 / 36 01 / 40 01 / 42 02 / 44 02 / 44 03 / 44 04 のACK、DPI・ポーリング・LOD・明るさ・ライトの書き込みを実機確認。テスト後は元の値（1000Hz / ステージ2=800 / LOD 1mm / 明るさ16% / 常時点灯 白 / 速度50）へ復元",
    "limitations": "ライトの「カラー」はソリッド/ブリージングで使用します。カラーサイクルはスペクトル固定です。FrameLightの色そのものは読み戻せないため、起動直後は白として表示される場合があります。"
  },

  "meta": {
    "name": "HyperX Pulsefire Haste 2 Wireless",
    "brand": "HyperX (HP)",
    "models": ["Pulsefire Haste 2 Wireless"],
    "connectionLabel": "ワイヤレス (2.4GHz)",
    "notes": "VID 0x03F0 / PID 0x0F98・0x0D97。NGENUITY universal 64バイトプロトコル。DPI・ポーリング・LOD・明るさ・LEDを読み書きできます。"
  },

  "usb": {
    "vendorId": "0x03F0",
    "productIds": ["0x0D97", "0x0F98"],
    "pidLabels": {
      "0x0D97": "2.4GHz ドングル",
      "0x0F98": "2.4GHz ドングル"
    },
    "vendorUsagePageMin": "0xFF00",
    "probeCommand": "getInfo"
  },

  "transport": {
    "type": "ngenuityUniversal",
    "reportId": 0,
    "packetLength": 64
  },

  "commands": {
    "getInfo": { "id": "0x10", "sub": "0x01", "expectReply": true },
    "deviceOnline": {
      "id": "0x52",
      "sub": "0x01",
      "expectReply": true,
      "response": { "online": 2 }
    },
    "battery": {
      "id": "0x50",
      "sub": "0x02",
      "expectReply": true,
      "response": { "level": 2, "charging": 3 }
    },
    "getDpi": { "id": "0x32", "sub": "0x02", "expectReply": true },
    "getSensor": { "id": "0x36", "sub": "0x02", "expectReply": true },
    "getBrightness": { "id": "0x40", "sub": "0x02", "expectReply": true },
    "getLighting": { "id": "0x42", "sub": "0x03", "expectReply": true },
    "setDpi": { "id": "0x32", "sub": "0x01" },
    "setSensor": { "id": "0x36", "sub": "0x01" },
    "setBrightness": { "id": "0x40", "sub": "0x01" },
    "setLighting": { "id": "0x42", "sub": "0x02", "expectReply": true },
    "frameHeader": { "id": "0x44", "sub": "0x03" },
    "frameData": { "id": "0x44", "sub": "0x04", "expectReply": true },
    "liveColor": { "id": "0x44", "sub": "0x02", "expectReply": true }
  },

  "ui": {
    "deviceInfo": [
      { "key": "product", "label": "製品" },
      { "key": "connection", "label": "接続方式" },
      { "key": "mouseVersion", "label": "ファームウェア" }
    ],

    "readButton": {
      "label": "デバイスから設定を読み出す",
      "note": "DPI・ポーリングレート・LOD・明るさ・ライト設定をデバイスから読み戻します。",
      "successMessage": "設定を読み出しました"
    },

    "sections": [
      {
        "title": "DPI設定",
        "settings": [
          {
            "key": "dpi",
            "type": "dpiStages",
            "label": "DPI",
            "maxRecords": 5,
            "colors": true,
            "valueRange": { "min": 200, "max": 26000, "step": 50 },
            "count": { "read": { "codec": "byte" } },
            "current": { "read": { "codec": "byte" } },
            "value": { "read": { "codec": "le16" } },
            "color": { "read": { "codec": "rgb" } },
            "hint": "200〜26000（50刻み）。ステージ色はDPIインジケーターの色です。"
          }
        ]
      },
      {
        "title": "ポーリングレート",
        "settings": [
          {
            "key": "polling",
            "type": "segmented",
            "label": "ポーリングレート",
            "unit": " Hz",
            "options": [
              { "value": 125, "label": "125" },
              { "value": 250, "label": "250" },
              { "value": 500, "label": "500" },
              { "value": 1000, "label": "1000" }
            ],
            "hint": "2.4GHz接続時のレートです（125/250/500/1000Hz）。"
          }
        ]
      },
      {
        "title": "センサー設定",
        "settings": [
          {
            "key": "lod",
            "type": "segmented",
            "label": "Lift-off Distance (LOD)",
            "options": [
              { "value": 1, "label": "1 mm" },
              { "value": 2, "label": "2 mm" }
            ],
            "hint": "リフトオフ距離（1mm / 2mm）。"
          }
        ]
      },
      {
        "title": "ライト設定",
        "settings": [
          {
            "key": "brightness",
            "type": "slider",
            "label": "明るさ",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": " %",
            "hint": "0〜100%。0で消灯します。"
          },
          {
            "key": "light",
            "type": "group",
            "label": "ライト",
            "fields": [
              {
                "key": "effect",
                "type": "select",
                "label": "モード",
                "read": {
                  "codec": {
                    "type": "enum",
                    "values": [
                      { "value": 0, "code": 0, "label": "オフ" },
                      { "value": 1, "code": 1, "label": "常時点灯" },
                      { "value": 2, "code": 2, "label": "ブリージング" },
                      { "value": 4, "code": 4, "label": "カラーサイクル" }
                    ]
                  }
                }
              },
              {
                "key": "color",
                "type": "color",
                "label": "カラー",
                "read": { "bytes": 3, "codec": "rgb" }
              },
              {
                "key": "speed",
                "type": "slider",
                "label": "速度",
                "min": 0,
                "max": 255,
                "step": 1,
                "read": { "codec": "byte" },
                "hint": "0〜255。小さいほど速くなります（ブリージング/カラーサイクル）。"
              }
            ]
          }
        ]
      }
    ]
  }
}
