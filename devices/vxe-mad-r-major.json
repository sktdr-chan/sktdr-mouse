    "readButton": {
      "label": "デバイスから設定を読み出す",
      "note": "マウス本体から全設定（DPI・ポーリングレート・センサー設定など）を再読み込みします。マウスがスリープ中は動かして起こしてください。",
      "successMessage": "マウスから設定を読み出しました"
    },
    "sections": [
      {
        "title": "DPI設定",
        "settings": [
          {
            "key": "dpi",
            "type": "dpiStages",
            "label": "DPI",
            "maxRecords": 8,
            "countEditable": false,
            "colors": true,
            "valueRange": {
              "min": 100,
              "max": 30000,
              "step": 50
            },
            "count": {
              "read": {
                "address": "0x00",
                "bytes": 0,
                "codec": "byte",
                "fixed": 8
              },
              "write": {}
            },
            "current": {
              "read": {
                "address": "0x04",
                "bytes": 1,
                "codec": "byte"
              },
              "write": {
                "mode": "singleByte"
              }
            },
            "value": {
              "read": {
                "address": "0x0c",
                "stride": 4,
                "bytes": 4,
                "codec": {
                  "type": "dpiXY",
                  "step": 50,
                  "min": 100,
                  "max": 30000
                }
              },
              "write": {
                "mode": "bytes"
              }
            },
            "color": {
              "read": {
                "address": "0x2c",
                "stride": 4,
                "bytes": 4,
                "codec": "rgbComplement"
              },
              "write": {
                "mode": "bytes"
              }
            },
            "hint": "8スロット固定。DPIはX/Y独立ですが、本ツールはX=Yとして書き込みます（レンジ100〜30000、50刻み）。マウスのDPIボタンで切替すると自動反映されます。"
          }
        ]
      },
      {
        "title": "ポーリングレート",
        "settings": [
